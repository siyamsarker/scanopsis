# Copy this file to .env and edit it. Do not put secrets here: the database
# URL and the secret key come from files under ./secrets (see compose.yaml).
# The reference for every variable is docs/configuration.md.

# The image to run: the tag that you gave to `make image IMAGE=...`. The
# guides build scanopsis:v0.4.3, the newest version. A plain `make image`
# builds scanopsis:dev instead.
SCANOPSIS_IMAGE=scanopsis:v0.4.3

# Required. The address users and pipelines use to reach Scanopsis, without a
# path. Use https:// when a reverse proxy terminates TLS. The GitLab redirect
# URI is this address plus /api/v1/auth/gitlab/callback.
SCANOPSIS_PUBLIC_URL=https://scanopsis.example.com

# Optional. The host address and port where Compose publishes Scanopsis. The
# defaults publish it on the loopback interface only, so that nothing outside
# the host can reach it. Set SCANOPSIS_BIND=0.0.0.0 only if no proxy runs on
# the host and you accept plain HTTP on the network.
# SCANOPSIS_BIND=127.0.0.1
# SCANOPSIS_PORT=8080

# Optional. The time zone of the timestamps in the log, for example
# Europe/Berlin. The default is UTC. Stored data is not affected.
# TZ=UTC

# Optional. Addresses of reverse proxies whose X-Forwarded-For header is
# trusted, as a comma-separated list of IP addresses or CIDR ranges. For a
# proxy in a container, use the fixed address you give it in
# compose.override.yaml. For a proxy on the host, use the gateway of the
# Compose network, which this prints (use the IPv4 address), and only while
# SCANOPSIS_BIND stays 127.0.0.1:
#   docker network inspect scanopsis_frontend --format '{{range .IPAM.Config}}{{println .Gateway}}{{end}}'
# See docs/deployment.md, "Reverse proxy and TLS".
# SCANOPSIS_TRUSTED_PROXIES=

# Optional. debug, info, warn or error. The default is info.
# SCANOPSIS_LOG_LEVEL=info

# Optional. A PEM file with extra certificate authorities to trust for GitLab
# and SonarQube (not for the database). Mount the file in
# compose.override.yaml first, see docs/deployment.md, "Trust an internal
# certificate authority".
# SCANOPSIS_CA_FILE=/etc/scanopsis/ca.pem

# The settings below only seed the Settings page on the first start. After
# that, the Settings page is the source of truth, and changing them here has
# no effect on a setting that was already saved there.
# SCANOPSIS_GITLAB_URL=https://gitlab.example.com
# SCANOPSIS_GITLAB_CLIENT_ID=
# SCANOPSIS_GITLAB_ALLOWED_GROUPS=platform,security/appsec
# SCANOPSIS_LOCAL_LOGIN_ENABLED=true
# SCANOPSIS_SESSION_IDLE_TIMEOUT=30m
# SCANOPSIS_SESSION_ABSOLUTE_TIMEOUT=12h
# SCANOPSIS_INGEST_ALLOWED_NAMESPACES=platform
# SCANOPSIS_INGEST_PROTECTED_REFS_ONLY=false
# SCANOPSIS_SONAR_URL=https://sonarqube.example.com
# SCANOPSIS_SONAR_SYNC_INTERVAL=15m
# SCANOPSIS_RETENTION_DAYS=90
# Do not put the GitLab client secret, the SonarQube token or the SonarQube
# webhook secret here. Mount each as a file and set its _FILE variable
# (docs/configuration.md, "File variants and Docker secrets"), or enter them
# on the Settings page, where they are stored encrypted. Scanopsis does not
# start with SCANOPSIS_GITLAB_CLIENT_ID set but no client secret, or with
# SCANOPSIS_SONAR_URL set but no token: set those on the Settings page too.
